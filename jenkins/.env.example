# Copy to .env (ignored by Git) and fill in. Never commit .env.
KAIS_PASSWORD=change-me
NESRINE_PASSWORD=change-me
AMINE_PASSWORD=change-me

# GitHub fine-grained token, read-only "Contents" on the repo
GITHUB_USER=Kaisoueriemmi
GITHUB_TOKEN=

# Docker Hub access token (Account settings > Personal access tokens)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# URL the team uses to open Jenkins (Tailscale IP or VPS)
JENKINS_PUBLIC_URL=http://localhost:8080/

# Docker socket group: 0 on Docker Desktop, `stat -c %g /var/run/docker.sock` on Linux
DOCKER_GID=0
